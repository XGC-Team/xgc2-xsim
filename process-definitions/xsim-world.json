{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "xsim-world",
      "version": "2.0.0",
      "label": "xsim world",
      "description": "One native xsim world. The workflow supplies frozen Experiment input, scene, target identity and a private Unix endpoint; the generic Process owns its OS lifecycle.",
      "parameters": {
        "properties": {
          "installRoot": {
            "type": "string",
            "default": "/opt/xgc2/xsim"
          },
          "configJson": {
            "type": "string",
            "default": "",
            "description": "Opaque frozen Experiment input forwarded verbatim through stdin to the native server."
          },
          "socketPath": {
            "type": "string",
            "default": "",
            "description": "Explicit private Unix control socket supplied by the workflow.",
            "fixedOnly": true
          },
          "rosInstallPath": {
            "type": "string",
            "description": "Absolute ROS installation prefix",
            "default": "/opt/ros/noetic",
            "x-xgc-path-kind": "directory"
          },
          "rosIp": {
            "type": "string",
            "description": "ROS_IP advertised by xsim",
            "default": "127.0.0.1",
            "output": true
          },
          "rosMasterUri": {
            "type": "string",
            "description": "Pre-allocated session ROS_MASTER_URI; the master may start after xsim.",
            "fixedOnly": true
          },
          "sceneFile": {
            "type": "string",
            "default": "",
            "description": "Prepared scene file consumed and validated by xsim."
          },
          "targetId": {
            "type": "string",
            "description": "Explicit workflow-owned world target identity, independent of the native process incarnation.",
            "fixedOnly": true
          }
        },
        "groups": [
          {
            "id": "ros-advanced",
            "label": "ROS Advanced",
            "collapsed": true,
            "parameters": [
              "rosInstallPath",
              "rosIp",
              "rosMasterUri"
            ]
          }
        ],
        "required": [
          "socketPath",
          "targetId",
          "rosMasterUri",
          "configJson"
        ]
      },
      "command": {
        "executable": "${installRoot}/bin/xsim",
        "args": [
          "--experiment-stdin",
          "--socket",
          "${socketPath}",
          "--target-id",
          "${targetId}",
          "--scene-file",
          "${sceneFile}"
        ],
        "env": {
          "ROS_HOSTNAME": "",
          "ROS_IP": "${rosIp}",
          "ROS_MASTER_URI": "${rosMasterUri}",
          "ROS_NAMESPACE": ""
        },
        "stdinParameter": "configJson"
      },
      "services": [
        {
          "service": "xgc2.simulation",
          "api_version": "v1",
          "profile": "http.v1",
          "endpointParameter": "socketPath"
        }
      ],
      "setupFiles": [
        "${rosInstallPath}/setup.bash"
      ],
      "readiness": {
        "kind": "describe",
        "startGraceMs": 15000,
        "timeoutMs": 30000
      },
      "stop": {
        "graceMs": 15000
      },
      "logs": {
        "maxBytes": 1048576,
        "files": 3
      }
    }
  ]
}
